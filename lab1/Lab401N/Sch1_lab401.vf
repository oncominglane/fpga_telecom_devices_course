                  .R(BTN0), 
                  .CEO(XLXN_6), 
                  .Q(dat[11:8]), 
                  .TC());
   VCB4RE  XLXI_6 (.ce(XLXN_6), 
                  .clk(XLXN_68), 
                  .R(BTN0), 
                  .CEO(), 
                  .Q(dat[15:12]), 
                  .TC());
   (* HU_SET = "XLXI_7_0" *) 
   OBUF8_MXILINX_Sch1_lab401  XLXI_7 (.I(SW[7:0]), 
                                     .O(LED[7:0]));
   BUFG  XLXI_8 (.I(F50MHz), 
