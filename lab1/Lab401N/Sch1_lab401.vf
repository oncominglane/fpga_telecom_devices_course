`timescale 1ns / 1ps

module Sch1_lab401(BTN0, 
                   BTN1, 
                   BTN3, 
                   F50MHz, 
                   SW, 
                   AN, 
                   LED, 
                   seg);

    input BTN0;
    input BTN1;
    input BTN3;
    input F50MHz;
    input [7:0] SW;
   output [3:0] AN;
   output [7:0] LED;
   output [7:0] seg;
   
   wire [15:0] dat;
   wire XLXN_4;
   wire XLXN_5;
   wire XLXN_6;
   wire XLXN_59;
   wire XLXN_68;
   wire XLXN_83;
   wire XLXN_86;
   
   DISPLAY  XLXI_1 (.clk(XLXN_68), 
                   .dat(dat[15:0]), 
                   .PTR(SW[5:4]), 
                   .AN(AN[3:0]), 
                   .ce1ms(XLXN_59), 
                   .SEG(seg[7:0]));
   Gen_Nms_1s  XLXI_2 (.ce(XLXN_59), 
                      .clk(XLXN_68), 
                      .Tmod(SW[7]), 
