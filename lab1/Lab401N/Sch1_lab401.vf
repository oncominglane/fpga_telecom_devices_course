                    .clk(XLXN_68), 
                    .clr(BTN0), 
                    .di(SW[3:0]), 
                    .L(BTN3), 
                    .up(SW[6]), 
                    .CEO(XLXN_4), 
                    .Q(dat[3:0]), 
                    .TC());
   VCJ4RE  XLXI_4 (.ce(XLXN_4), 
                  .clk(XLXN_68), 
                  .R(BTN0), 
                  .CEO(XLXN_5), 
                  .Q(dat[7:4]), 
                  .TC());
   VCD4RE  XLXI_5 (.ce(XLXN_5), 
